APP_ENV=development
APP_PORT=8503
DATABASE_PATH=data/app.db
STORAGE_ROOT=storage

VIDEO_PROVIDER=mock

REAL_VIDEO_MAX_TASKS=1
REAL_VIDEO_MAX_CONCURRENCY=1
REAL_VIDEO_MAX_COST_USD=1.00

# BytePlus ModelArk Seedance configuration.
# Do not commit real secrets in .env.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=
SEEDANCE_POLL_INTERVAL_SECONDS=10
SEEDANCE_REQUEST_TIMEOUT_SECONDS=30
SEEDANCE_MAX_POLL_MINUTES=30
